# Silicon Labs Project Configuration Tools: slcp, v0, Component selection file.
project_name: v2_X
label: v2_X
description: |
  V2X Autonomous Vehicle Platform: Integrated AI/ML gesture/motion recognition and Wi-Fi V2X/BSM telemetry on SiWG917.
category: AI/ML & Wireless Application
filter:
- name: Capability
  value:
  - Machine Learning
  - Wireless
- name: Device Type
  value:
  - SoC
- name: MCU
  value:
  - 32-bit MCU
- name: Project Difficulty
  value:
  - Advanced
- name: Wireless Technology
  value:
  - Wi-Fi
package: wifi_v2x_app
quality: production
readme:
- path: readme.md
source:
- path: main.c
- path: app.c
- path: accelerometer.c
- path: rgb_led.c
- path: bsm.c
include:
- path: .
  file_list:
  - path: app.h
  - path: accelerometer.h
  - path: bsm_packet.h
  - path: constants.h
  - path: rgb_led.h
  - path: bsm.h
sdk:
  vendor: silabs
  id: simplicity_sdk
  version: 2025.12.3
toolchain_settings:
- value: -u _printf_float
  option: gcc_linker_option
- value: -Wall -Werror
  option: gcc_compiler_option
- value: -Wno-unused-parameter
  option: gcc_compiler_option
- value: -mfp16-format=ieee
  option: gcc_compiler_option
- value: -Wno-missing-field-initializers
  option: gcc_compiler_option
